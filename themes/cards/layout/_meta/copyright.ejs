<% if (theme.meta.copyright.enable && page.copyright !== false) { %>
    <div class="post__license">
        <p style="font-weight: bold;">
            <strong><%= __('post.copyright.author') %></strong> <%= theme.meta.author.name %>
        </p>
        <p>
            <strong>
                <%= __('post.copyright.permalink') %>
            </strong>
            <a href="<%= page.permalink %>"><%= page.permalink %></a>
        </p>
        <% (theme.meta.copyright.custom_text || []).forEach((text) => { %>
            <strong>
                <%- markdown(text) %>
            </strong>
        <% }); %>
        <div class="post_reward active">
            <p>打赏博主😘</p>
                <div class="reward-container">
                    <div class="reward-wechat" onclick="openWechatReward()" title="微信赞赏">
                        微信赞赏
                    </div>
                </div>
        </div>
        <div class="wechat-reward-modal" id="wechat-reward-modal" aria-hidden="true">
            <div class="wechat-reward-mask" onclick="closeWechatReward()"></div>
            <div class="wechat-reward-box">
                <img src="https://cdn.luogu.com.cn/upload/image_hosting/lk5s3h7d.webp" alt="微信赞赏码">
                <button type="button" class="wechat-reward-close" aria-label="关闭" onclick="closeWechatReward()">&times;</button>
            </div>
        </div>
        <script>
            (function () {
                function getModal() {
                    return document.getElementById('wechat-reward-modal');
                }
                window.openWechatReward = function () {
                    var modal = getModal();
                    if (!modal) return;
                    if (modal.parentNode !== document.body) {
                        document.body.appendChild(modal);
                    }
                    modal.classList.add('show');
                    modal.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                };
                window.closeWechatReward = function () {
                    var modal = getModal();
                    if (!modal) return;
                    modal.classList.remove('show');
                    modal.setAttribute('aria-hidden', 'true');
                    document.body.style.overflow = '';
                };
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') window.closeWechatReward();
                });
            })();
        </script>

    </div>
<% } %>