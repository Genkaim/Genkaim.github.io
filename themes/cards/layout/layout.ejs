<!DOCTYPE html>
<html lang="<%= config.language%>">
  <%- partial('_partial/head/index') %>
  <!-- Pjax 过渡动画样式 -->
  <style>
    body.pjax-transitioning > #app > :not(header) {
      opacity: 0.3;
      transition: opacity 0.15s ease-out;
      will-change: opacity;
    }

    @keyframes main-fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .main,
    body.is-home > #app > .cover {
      animation: main-fade-in 0.2s ease-out;
    }

    .cover {
      position: relative;
      z-index: 1;
    }

    /* 非首页封面默认隐藏，避免 PJAX 交换瞬间闪现；首页封面不受影响 */
    body:not(.is-home) > #app > .cover {
      display: none;
    }

    /* 首页封面首帧即全屏，避免脚本写入高度前的跳变；仅补高度，不动盒模型其余部分 */
    body.is-home > #app > .cover {
      height: 100vh;
    }
  </style>
  
  <body class="<%= (is_home() && is_current('/', true)) ? 'is-home' : '' %>">
