    <div id="app" tabindex="-1" data-pjax-container>
      <%- partial('_partial/source/cover') %> <%- body %> <%-
      partial('_partial/source/footer', null, {cache: !config.relative_link}) %>
    </div>

    <div class="dropdown-backdrop" id="dropdown-backdrop"></div>

    <%- partial('_partial/music-player') %>

    <%- partial('_partial/scripts/index') %>
    
<script>
  /** =========================
   * 全局事件（只绑定一次）
   * ========================= */
  let isGlobalEventsBound = false;

  // Safari 不显示遮罩
  if (navigator.userAgent.indexOf('Safari') !== -1 && navigator.userAgent.indexOf('Chrome') === -1) {
    var style = document.createElement('style');
    style.textContent = '.dropdown-backdrop, .toc-backdrop { display: none !important; } #dropdown-menus, .toc-menus { box-shadow: 0 6px 20px rgba(0,0,0,0.18) !important; }';
    document.head.appendChild(style);
  }


  function bindGlobalEvents() {
    if (isGlobalEventsBound) return;

    /** scroll */
    /** scroll（控制返回顶部按钮） */
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const btn = document.querySelector("#b2t");
          if (btn) {
            btn.style.opacity = window.scrollY > 100 ? '1' : '0';
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    /** resize（首页封面高度） */
  window.addEventListener("resize", () => {
    if (!window.__IS_HOME__) return;

    const cover = document.querySelector(".cover");
    if (!cover) return;

    cover.style.height = `${window.innerHeight}px`;
  });
    isGlobalEventsBound = true;
  }

  /** =========================
   * 返回顶部按钮
   * ========================= */
  function setupBackToTopButton() {
    const button = document.querySelector("#b2t");
    if (!button) return;

    const newButton = button.cloneNode(true);
    button.parentNode.replaceChild(newButton, button);

    newButton.addEventListener('click', () => {
      newButton.style.opacity = '0';
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  /** =========================
   * 初始化懒加载图片
   * ========================= */
  function initLazyLoad() {
    if (typeof LazyLoad === 'undefined') return;

    if (window.lazyLoadInstance) {
      window.lazyLoadInstance.update();
    } else {
      window.lazyLoadInstance = new LazyLoad({
        elements_selector: 'img.lazy',
        threshold: 0
      });
    }
  }

  /** =========================
   * 页面初始化（PJAX 每次执行）
   * ========================= */
  function initPageScripts() {    
    const currentUrl = window.location.href;
    const pathname = window.location.pathname;

    /** 是否首页 */
    window.__IS_HOME__ = pathname === "/";
    /** 同步 body 类，供封面隐藏等样式规则使用 */
    document.body.classList.toggle('is-home', window.__IS_HOME__);
    /** 是否文章页 */
    const isPostPage = document.querySelector('.post__content') || 
                       document.querySelector('.article') ||
                       pathname.includes('/posts/') ||
                       pathname.match(/^\d{4}\/\d{2}\/\d{2}\//);
    
    if (!window.__IS_HOME__) {
      console.log('非首页，隐藏 cover');
      const cover = document.querySelector(".cover");
      const main = document.querySelector(".main");
      const footer = document.querySelector(".footer");
      
      if (cover) {
        cover.style.setProperty("display", "none", "important");
      }
      
      // 获取头部高度并设置 post-list 的 margin-top
      const header = document.querySelector("header") || document.querySelector(".head");
      const nav = document.querySelector("nav") || document.querySelector(".nav");
      const postList = document.querySelector(".post-list");
      
      if (header && postList) {
        const headerHeight = header.offsetHeight;
        postList.style.setProperty("margin-top", `${headerHeight}px`, "important");
      }
      
      // 设置 post-list 的最小高度为屏幕高度减去 header、nav 和 footer 的实际占用空间
 if (postList && footer) {
        const headerElement = header || document.querySelector("header");
        const navElement = nav || document.querySelector(".nav");
        
        // 获取各元素的实际高度（包括 margin 和 padding）
        const headerRect = headerElement ? headerElement.getBoundingClientRect() : { height: 0 };
        const navRect = navElement ? navElement.getBoundingClientRect() : { height: 0 };
        const footerRect = footer.getBoundingClientRect();
        
        // 获取 footer 的样式，计算 margin-bottom
        const footerStyle = window.getComputedStyle(footer);
        const footerMarginBottom = parseFloat(footerStyle.marginBottom) || 0;
        
        // 计算可用高度：屏幕高度 - header高度 - nav高度 - footer高度 - footer的margin-bottom
        const headerHeight = headerRect.height;
        const navHeight = navRect.height;
        const footerHeight = footerRect.height;
        const availableHeight = window.innerHeight - headerHeight - navHeight - footerHeight - footerMarginBottom*2;
        
        // 获取 post-list 的实际高度
        const postListRect = postList.getBoundingClientRect();
        const postListHeight = postListRect.height;
        
        // 如果 post-list 的实际高度小于可用高度，则设置最小高度
        if (postListHeight < availableHeight) {
          postList.style.setProperty("min-height", `${availableHeight}px`, "important");
          console.log('Post list min-height set to:', availableHeight);
        } else {
          postList.style.removeProperty("min-height");
        }
      }
      
      // 只在非首页时调整 main 和 footer 的位置
      if (main) {
        main.style.setProperty("top", "0", "important");
      }
      if (footer) {
        footer.style.setProperty("top", "0", "important");
      }
    } else {
      const cover = document.querySelector(".cover");
      if (cover) {
        cover.style.removeProperty("display");
        cover.style.height = `${window.innerHeight}px`;
      }
      
      // 首页时恢复默认位置
      const main = document.querySelector(".main");
      const footer = document.querySelector(".footer");
      const postList = document.querySelector(".post-list");
      
      if (main) {
        main.style.removeProperty("top");
      }
      if (footer) {
        footer.style.removeProperty("top");
      }
      if (postList) {
        postList.style.removeProperty("margin-top");
        postList.style.removeProperty("min-height");
      }
    }
    /** 初始化懒加载图片 */
    initLazyLoad();

    /** KaTeX */
    const postContent = document.querySelector(".post__content");
    if (postContent) {
      const children = postContent.children;
      for (let child of children) {
        if (child.classList.contains("katex-block")) {
          child.style.background = "#f4f4f44d";
          child.style.borderRadius = "7px";

          child.querySelectorAll('.base').forEach(base => {
            base.style.marginBottom = '8px';
            base.style.marginTop = '10px';
          });
        }
      }
    }

    /** 首页封面 */
    if (window.__IS_HOME__) {
      const cover = document.querySelector(".cover");
      
      if (cover) {
        cover.style.height = `${window.innerHeight}px`;
      }
    }

    /** 返回顶部按钮 */
    setupBackToTopButton();

    /** 归档页 */
    const isArchivesPage =
      currentUrl === window.location.origin + "/archives" ||
      currentUrl === window.location.origin + "/archives/";

    /** 代码复制 */
    document.querySelectorAll(".highlight").forEach((highlight) => {
      if (highlight.querySelector(".highlight_header")) return;

      const classes = [...highlight.classList].filter(c => c !== "highlight");
      const table = highlight.querySelector("table");
      if (!table) return;

      if (table.offsetHeight > 500) table.style.height = '500px';

      const div = document.createElement("div");
      div.classList.add("highlight_header");

      const show = document.createElement("text");
      show.textContent = classes[0];
      show.classList.add("highlight_language");

      const button = document.createElement("button");
      button.textContent = "Copy";
      button.classList.add("highlight_copy_button");

      const codeContent = table.querySelector(".code").innerText;

      button.addEventListener("click", () => {
        navigator.clipboard.writeText(codeContent).then(() => {
          button.textContent = "✔";
          setTimeout(() => button.textContent = "Copy", 2000);
        }).catch(() => {
          button.textContent = "Error";
          setTimeout(() => button.textContent = "Copy", 2000);
        });
      });

      div.appendChild(show);
      div.appendChild(button);
      highlight.insertBefore(div, highlight.firstChild);
    });

    /** waline 邮箱占位符 */
    (function checkWalineMail() {
      var mailInput = document.querySelector('#wl-mail');
      if (mailInput) {
        mailInput.setAttribute('placeholder', '可用于接收回复通知');
      } else {
        setTimeout(checkWalineMail, 500);
      }
    })();
  }

  /** =========================
   * PJAX
   * ========================= */
  if (typeof Pjax !== 'undefined') {
    new Pjax({
      elements: "a:not([data-no-pjax])",
      selectors: ["title", "[data-pjax-container]"],
      cacheBust: false
    });

    document.addEventListener('pjax:send', () => {
      requestAnimationFrame(() => {
        document.body.classList.add('pjax-transitioning');
      });
    });

    document.addEventListener('pjax:success', () => {
      document.body.classList.remove('pjax-transitioning');

      initPageScripts();

      /** Waline */
      const walineContainer = document.querySelector('#waline');
      if (walineContainer) {
        walineContainer.innerHTML = '';
        import('/js/waline.js').then(module => {
          module.init({
            el: '#waline',
            serverURL: 'https://waline.genkaim.top',
          });
        });
      }
    });
  }

  /** 系统返回/前进导致 PJAX 请求失败或页面从缓存恢复时，清理过渡状态 */
  document.addEventListener('pjax:error', () => {
    document.body.classList.remove('pjax-transitioning');
  });

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      document.body.classList.remove('pjax-transitioning');
    }
  });

  /** =========================
   * 首次加载
   * ========================= */
  document.addEventListener('DOMContentLoaded', () => {
    bindGlobalEvents();
    initPageScripts();
  });
</script>
  </body>
</html>